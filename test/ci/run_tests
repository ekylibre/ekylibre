#!/bin/bash
set -e

function psql_exec {
  psql -h "${POSTGRES_HOST}" -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" -c "$1"
}

(
    cd /app

    cat $1 > .env

    bash test/ci/wait_pg.sh "${POSTGRES_HOST}" "${POSTGRES_USER}" "${POSTGRES_DB}"

    # One statement per psql call, and IF EXISTS on the drop. These two used to
    # share a single -c, which couples them: a failing DROP EXTENSION rolls back
    # the CREATE SCHEMA in the same implicit transaction, and every following
    # CREATE EXTENSION then dies with 'schema "postgis" does not exist'. That
    # does not happen with an image shipping postgis pre-installed, but it makes
    # the setup depend on what the image happens to provide.
    psql_exec 'DROP EXTENSION IF EXISTS postgis CASCADE;'
    psql_exec 'CREATE SCHEMA IF NOT EXISTS postgis;'
    psql_exec 'CREATE EXTENSION IF NOT EXISTS postgis SCHEMA postgis;'
    psql_exec 'CREATE EXTENSION IF NOT EXISTS "uuid-ossp" SCHEMA postgis;'
    psql_exec 'CREATE EXTENSION IF NOT EXISTS "unaccent" SCHEMA postgis;'
    psql_exec 'CREATE EXTENSION IF NOT EXISTS "pg_trgm" SCHEMA postgis;'
    
    cp -f test/ci/database.yml config/database.yml

    gpg --import 'test/fixture-files/my-private-key.asc'

    echo "GPG keys list:"
    gpg --list-keys

    bundle exec rake db:migrate RAILS_ENV=test VERBOSE=false

    COVERAGE=true CI=true bin/rails test 
)
