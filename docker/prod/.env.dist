# =============================================================================
# Ekylibre — Configuration de production
# Copier vers .env et personnaliser AU MINIMUM les variables marquées REQUIRED.
# =============================================================================

# === Application ===
RAILS_ENV=production

# Image Ekylibre (publique sur GHCR — buildée par .github/workflows/build-prod-image.yml).
# Variantes : `latest` | `<branche>` (ex: `5.0-beta`) | `v<version>` (recommandé en prod)
EKYLIBRE_IMAGE_TAG=latest

HOST_DOMAIN_NAME=example.com                  # REQUIRED — SANS protocole, SANS sous-domaine
ADMIN_USERNAME=admin                          # REQUIRED — auth HTTP Basic sur /admin
ADMIN_PASSWORD=ChangeMe!                      # REQUIRED — 16+ caractères recommandés
SECRET_KEY_BASE=                              # REQUIRED — générer avec : openssl rand -hex 64

# Clé AES-256 (base64 urlsafe) utilisée par ActionIntegration pour chiffrer
# les credentials des intégrations tierces (Isagri, Telepac, Baqio, Google...).
# Sans clé valide, toute création/lecture d'intégration lève une CipherError.
# Générer avec :
#   ruby -rsecurerandom -rbase64 -e "puts Base64.urlsafe_encode64(SecureRandom.random_bytes(32))"
# ou : openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
# IMPORTANT : ne jamais la changer une fois des intégrations créées — les
# credentials chiffrés en base deviendraient irrécupérables.
INTEGRATION_CIPHER_BASE64_KEY=                # REQUIRED — 32 octets base64 urlsafe

RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
WEB_CONCURRENCY=2                             # Nombre de workers Puma
RAILS_MAX_THREADS=5                           # Threads par worker

# === Database ===
DB_HOST=db
DB_PROD_NAME=eky_production
DB_USERNAME=ekylibre
DB_PASSWORD=ChangeMe!                         # REQUIRED

# === Redis ===
REDIS_URL=redis://redis

# === TLS (Let's Encrypt — HTTP-01 challenge) ===
LETSENCRYPT_EMAIL=admin@example.com           # REQUIRED — pour les notifications de cert

# === Lexicon download / Object storage ===
# Le `rake lexicon:load` telecharge les paquets depuis io.ekylibre.tech (MinIO).
# Si MINIO_ACCESS_KEY/MINIO_SECRET_KEY sont vides, un fallback HTTP anonyme est
# utilise (fonctionne sur les buckets publics, ex: 6.0.2-innovation et suivants).
# Renseigner uniquement si vous avez besoin d'acceder a un bucket prive.
MINIO_HOST=https://io.ekylibre.tech
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# === Liste des tenants (bind-mount config/tenants.yml) ===
# Le fichier persiste hors du container pour survivre aux redeploys.
# Init obligatoire avant le premier `up` :
#   touch tenants.yml
#   sudo chown 1000:1000 tenants.yml
#   sudo chmod 664 tenants.yml
#   echo "---\nproduction: []" > tenants.yml  # optionnel : initialisation YAML valide
TENANTS_YML_PATH=./tenants.yml

# === GPG (signature de documents et cloture d'exercice) ===
# Chemin hote vers le keyring GPG, monte en read-only dans le container.
# Voir docker/prod/GPG.md pour la generation de la cle.
# Laisser vide ou commenter pour ne pas activer la signature GPG.
GPG_KEYRING_PATH=./secrets/gnupg
GPG_EMAIL=                                    # ex: ekylibre@example.com (doit matcher l'UID de la cle)

# === Mail (SMTP) ===
# Si SMTP_ADDRESS est vide, Rails utilise sendmail local (non disponible dans le container).
# Renseigner au minimum SMTP_ADDRESS pour activer le transport SMTP.
SMTP_ADDRESS=                                 # ex: smtp.sendgrid.net, smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login                     # login | plain | cram_md5
SMTP_STARTTLS=auto                            # `auto` active STARTTLS automatique

# Notifications d'exception (optionnel)
EXCEPTION_NOTIFICATION_PREFIX=[Exception]
EXCEPTION_NOTIFICATION_SENDER='Ekylibre <notifications@example.com>'
EXCEPTION_NOTIFICATION_RECIPIENT=admin@example.com

# === Observability (optionnel) ===
ELASTIC_APM_ACTIVE=false

# =============================================================================
# Duke — Assistant chatbot agricole (OPTIONNEL)
# Activer avec : docker compose --profile duke up -d
# Ou : ./docker/prod/scripts/duke-up.sh
# =============================================================================

# Image Duke (publique sur GHCR — aucun build local).
# Variantes : `latest` (slim) | `latest-stt` (Whisper STT bundled, ~+250 MB)
# Pour la prod stable : pin sur une version (ex: v0.2.3)
DUKE_IMAGE_TAG=latest

# Rôle PostgreSQL lecture seule créé automatiquement par docker/db/init-duke-role.sh
# Laisser vides pour NE PAS créer le rôle (déploiement sans Duke).
DUKE_USER=duke_reader
DUKE_PASSWORD=ChangeMe!

# Duke own DB (Postgres 16 séparé, instance dédiée)
DUKE_DB_USER=duke
DUKE_DB_PASSWORD=ChangeMe!
DUKE_DB_NAME=duke

# DSN injectés dans le container duke-api (référencent les noms de services Compose,
# résolus nativement sur le réseau partagé `ekylibre`).
EKYLIBRE_API_BASE_URL=http://app:3000
EKYLIBRE_DB_DSN=postgresql://duke_reader:ChangeMe!@db:5432/eky_production
DUKE_DB_DSN=postgresql+asyncpg://duke:ChangeMe!@postgres-duke:5432/duke

# Audit / RGPD — OBLIGATOIRE en prod (hash tenant+email dans audit log)
HASH_SECRET=                                  # openssl rand -hex 32

# Whisper STT (opt-in — nécessite DUKE_IMAGE_TAG=latest-stt)
ENABLE_SERVER_STT=false

# LLM providers (au moins 1 requis si Duke activé)
LLM_DEFAULT_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Local LLM via Ollama (sous-profile duke-llm-local)
# Activer avec : ./docker/prod/scripts/duke-up.sh --with-local-llm
OLLAMA_BASE_URL=                              # http://ollama:11434 si activé
OLLAMA_MODEL=mistral-nemo

# WS sécurité
ALLOWED_WS_ORIGINS=https://example.com,https://*.example.com
SESSION_IDLE_TIMEOUT_S=1800
RATE_LIMIT_PER_MIN=30
LOG_LEVEL=INFO
LOG_VERBOSE_PAYLOADS=false

# =============================================================================
# NanoClaw — Pont Telegram ↔ Duke ↔ Ekylibre (OPTIONNEL, dépend de Duke)
# Spec : claudedocs/workflow_nanoclaw_telegram_prod.md
# =============================================================================

# Image NanoClaw-Ekylibre (publique sur GHCR — buildée par .github/workflows/nanoclaw-image.yml)
# Variantes : `latest` | `v<version>` (recommandé en prod)
NANOCLAW_IMAGE_TAG=latest

# Clé API Anthropic — peut être la même que celle utilisée par Duke (ANTHROPIC_API_KEY).
# NB : NanoClaw upstream attend le nom ANTHROPIC_AUTH_TOKEN (pas ANTHROPIC_API_KEY).
ANTHROPIC_AUTH_TOKEN=

# Endpoint Anthropic custom — laisser vide (api.anthropic.com par défaut)
# ou définir, ex: https://api.eu.anthropic.com pour Bedrock UE.
ANTHROPIC_BASE_URL=

# Provider LLM par défaut quand le tenant ne le surcharge pas dans tenants.yml
NANOCLAW_LLM_PROVIDER=claude                  # claude | mistral | ollama

# Niveau de logs : error | warn | info | debug
NANOCLAW_LOG_LEVEL=info

# Chemin hôte vers le fichier nanoclaw-tenants.yml (SECRET — chmod 0600, root:root).
# Doit exister AVANT le `up`, sinon Docker le crée comme un répertoire.
# Init obligatoire avant le premier up :
#   sudo touch nanoclaw-tenants.yml
#   sudo chmod 0600 nanoclaw-tenants.yml
#   sudo chown root:root nanoclaw-tenants.yml
#   # puis éditer en partant de docker/prod/nanoclaw-tenants.example.yml
NANOCLAW_TENANTS_PATH=./nanoclaw-tenants.yml

# OneCLI gateway (https://app.onecli.sh) — REQUIS pour que les containers
# agent NanoClaw obtiennent leurs credentials Claude. Sans clé, les spawn
# échouent en exit 125 (cf. claudedocs/notes_nanoclaw_v2.md §1.6).
# Création de compte + récupération de la clé sur app.onecli.sh.
ONECLI_API_KEY=

# Endpoint OneCLI custom (vide = défaut https://app.onecli.sh)
ONECLI_URL=
