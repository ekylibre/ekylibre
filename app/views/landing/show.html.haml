%section.hero
  .container.hero-grid
    .hero-text
      %span.hero-eyebrow Plateforme agricole tout-en-un
      %h1.hero-title
        Une vue d'ensemble
        %br/
        de votre
        %em ferme
      %p.hero-lead
        L'ERP open source qui réunit production, comptabilité, ventes et planification
        dans un seul outil pensé pour les agriculteurs, viticulteurs et éleveurs.
      .hero-actions
        %a.btn.btn-primary{ href: '/admin' }
          Accéder à l'administration
          %span.arrow →
        %a.btn.btn-secondary{ href: 'https://ekylibre.org', target: '_blank', rel: 'noopener' }
          Découvrir le projet
      .hero-meta
        %div
          %strong 6
          modules métiers
        %div
          %strong 100%
          open source · AGPL
        %div
          %strong 30+
          formats d'import
    .hero-visual
      %canvas#fx-canvas
      = image_tag('landing/farm-illustration.jpg', alt: "Illustration d'une exploitation agricole et de ses modules de gestion", class: 'hero-image')
      .hero-badge
        %span.pulse>
        Toutes vos activités, en un seul endroit

%section#modules.modules
  .container
    .section-head
      %span.section-eyebrow Modules métiers
      %h2.section-title Tout ce qu'il faut pour piloter votre exploitation
      %p.section-sub
        Du suivi parcellaire à la déclaration de TVA, Ekylibre intègre les outils
        dont vous avez besoin pour gérer votre activité au quotidien.

    .modules-grid
      %article.module-card
        .module-icon
          :preserve
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
        %h3.module-title Stocks et équipements
        %p.module-desc Suivez vos matériels, intrants et bâtiments avec précision sur toute l'exploitation.
        %ul.module-tags
          %li #coûts
          %li #inventaire
          %li #géolocalisation

      %article.module-card
        .module-icon
          :preserve
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>
        %h3.module-title Planification et itinéraires techniques
        %p.module-desc Anticipez la campagne, simulez vos rotations et organisez les chantiers en équipe.
        %ul.module-tags
          %li #prévisionnel
          %li #simulation
          %li #campagne

      %article.module-card
        .module-icon
          :preserve
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/></svg>
        %h3.module-title Productions végétales et animales
        %p.module-desc Pilotez parcellaire, cheptel et interventions avec une traçabilité complète et réglementaire.
        %ul.module-tags
          %li #parcellaire
          %li #cheptel
          %li #traçabilité
          %li #ift
          %li #réglementaire

      %article.module-card
        .module-icon
          :preserve
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
        %h3.module-title Comptabilité
        %p.module-desc Tenez la compta de votre exploitation, des immobilisations à la TVA, en restant aux normes.
        %ul.module-tags
          %li #immobilisations
          %li #emprunts
          %li #déclaration-TVA
          %li #rapprochement-bancaire

      %article.module-card
        .module-icon
          :preserve
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        %h3.module-title Achats et ventes
        %p.module-desc Suivez tout le cycle commercial, des devis aux livraisons en passant par les paiements.
        %ul.module-tags
          %li #devis
          %li #commandes
          %li #factures
          %li #paiements
          %li #livraisons

      %article.module-card
        .module-icon
          :preserve
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
        %h3.module-title Indicateurs économiques
        %p.module-desc Mesurez la performance de votre exploitation et prenez des décisions sur des chiffres fiables.
        %ul.module-tags
          %li #budgets
          %li #marges
          %li #seuils
          %li #revenus
