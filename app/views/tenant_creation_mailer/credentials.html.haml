%p= t('mailers.tenant_creation_mailer.credentials.greeting')

%p= t('mailers.tenant_creation_mailer.credentials.intro', tenant: @tenant)

%table
  %tr
    %th= t('mailers.tenant_creation_mailer.credentials.url_label')
    %td= link_to(@url, @url)
  %tr
    %th= t('mailers.tenant_creation_mailer.credentials.email_label')
    %td= @email
  %tr
    %th= t('mailers.tenant_creation_mailer.credentials.password_label')
    %td
      %code= @password

%p
  %strong= t('mailers.tenant_creation_mailer.credentials.password_warning')

%p= t('mailers.tenant_creation_mailer.credentials.signature')
