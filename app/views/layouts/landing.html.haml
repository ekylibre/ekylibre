!!! 5
%html{ lang: 'fr' }
  %head
    %meta{ charset: 'utf-8' }
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }
    %title Ekylibre
    = csrf_meta_tags
    :css
      * { box-sizing: border-box; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: linear-gradient(135deg, #4a7c59 0%, #2d4a3a 100%); color: #fff; margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
      main { max-width: 720px; padding: 60px 40px; text-align: center; }
      h1 { font-size: 3em; margin: 0 0 0.3em; font-weight: 700; }
      p.tagline { font-size: 1.3em; opacity: 0.9; margin: 0 0 2em; }
      .actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
      a.btn { display: inline-block; padding: 14px 28px; border-radius: 6px; text-decoration: none; font-weight: 600; transition: transform .15s, box-shadow .15s; }
      a.btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.2); }
      a.btn-primary { background: #fff; color: #2d4a3a; }
      a.btn-secondary { background: rgba(255,255,255,.1); color: #fff; border: 1px solid rgba(255,255,255,.4); }
      footer { margin-top: 3em; opacity: 0.7; font-size: 0.9em; }
  %body
    %main= yield
