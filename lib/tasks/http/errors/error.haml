!!!
- title = "http.errors.#{name}.title".t
- require 'base64'
- owl_svg = File.read(Rails.root.join('lib', 'tasks', 'http', 'errors', 'duke-owl.svg'))
- owl_data_uri = "data:image/svg+xml;base64,#{Base64.strict_encode64(owl_svg)}"
%html
  %head
    %title= title
    %meta{charset: "UTF-8"}
    %meta{content: "width=device-width,initial-scale=1", name: "viewport"}
    :scss
      @import url(//fonts.googleapis.com/css?family=Open+Sans:300,400,600,700);
      $brand:        #3b8b3a;
      $brand-soft:   rgba(59, 139, 58, 0.18);
      $text-color:   #2d3a2d;
      $text-muted:   #6a766a;
      $bg-start:     #f6faf4;
      $bg-end:       #e3eedd;

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        margin: 0;
        height: 100%;
        background: linear-gradient(180deg, $bg-start 0%, $bg-end 100%);
        color: $text-color;
        font-family: 'Open Sans', sans-serif;
        overflow: hidden;
      }

      canvas#fx-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }

      .layout {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 6vh 6vw;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.55em;
        padding: 0.45em 1em;
        margin-bottom: 1.8em;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid $brand-soft;
        border-radius: 999px;
        font-size: 0.78em;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: $brand;
      }

      .badge .dot {
        width: 0.55em;
        height: 0.55em;
        border-radius: 50%;
        background: $brand;
        animation: pulse 2.4s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1;   transform: scale(1); }
        50%      { opacity: 0.35; transform: scale(0.7); }
      }

      h1 {
        font-size: clamp(1.6em, 3.2vw, 2.4em);
        font-weight: 300;
        line-height: 1.25;
        margin: 0 0 0.8em;
        max-width: 22ch;
        color: $text-color;
      }

      p {
        font-size: clamp(1em, 1.4vw, 1.15em);
        color: $text-muted;
        line-height: 1.65;
        margin: 0;
        max-width: 42ch;
      }

      .legals {
        text-align: center;
        padding: 1.4em 1em;
        font-size: 0.78em;
        letter-spacing: 0.08em;
        color: lighten($text-color, 25%);
        background: rgba(255, 255, 255, 0.45);
      }
    %script{src: "https://cdn.jsdelivr.net/npm/pixi.js@8.6.6/dist/pixi.min.js"}
  %body
    %canvas#fx-canvas
    .layout
      .content
        .badge
          %span.dot
          = "Erreur #{code}"
        %h1= title
        - hint = "http.errors.#{name}.hint".t(default: "")
        - unless hint.blank?
          %p= hint
      .legals= "Ekylibre #{Ekylibre::VERSION}"
    :javascript
      (function () {
        var canvas = document.getElementById('fx-canvas');
        if (!canvas || typeof PIXI === 'undefined') return;

        var app = new PIXI.Application();
        app.init({
          canvas: canvas,
          resizeTo: window,
          backgroundAlpha: 0,
          antialias: true,
          autoDensity: true,
          resolution: Math.min(window.devicePixelRatio || 1, 2)
        }).then(function () {
          var TAU = Math.PI * 2;
          // Variations de teinte autour du rouge Ekylibre (multiplie sur texture blanche)
          var tints = [0xd81e08, 0xa01806, 0xc94a2e, 0x8b3a1c, 0xe85a3a];

          return PIXI.Assets.load({
            src: '#{owl_data_uri}',
            data: { resolution: 4 }
          }).then(function (texture) {
            var owls = [];
            var stage = new PIXI.Container();
            app.stage.addChild(stage);

            function targetCount() {
              return Math.min(50, Math.max(15, Math.floor(app.screen.width * app.screen.height / 36000)));
            }

            function spawn(seedBelow) {
              var sprite = new PIXI.Sprite(texture);
              sprite.anchor.set(0.5);
              var scale = 0.025 + Math.random() * 0.055; // SVG 1000x1000 -> rendu 25..80 px
              sprite.scale.set(scale);
              sprite.tint = tints[Math.floor(Math.random() * tints.length)];
              sprite.alpha = 0.45 + Math.random() * 0.4;
              sprite.x = Math.random() * app.screen.width;
              sprite.y = seedBelow ? (app.screen.height + 40 + Math.random() * 80) : Math.random() * app.screen.height;
              sprite.driftPhase = Math.random() * TAU;
              sprite.driftSpeed = 0.004 + Math.random() * 0.010;
              sprite.driftAmp   = 0.4 + Math.random() * 0.9;
              sprite.bobPhase   = Math.random() * TAU;
              sprite.bobSpeed   = 0.02 + Math.random() * 0.025;
              sprite.bobAmp     = 0.10 + Math.random() * 0.22;
              sprite.vy         = -(0.15 + Math.random() * 0.45);
              sprite.spin       = (Math.random() - 0.5) * 0.0025;
              stage.addChild(sprite);
              owls.push(sprite);
            }

            var initial = targetCount();
            for (var i = 0; i < initial; i++) spawn(false);

            app.ticker.add(function (ticker) {
              var dt = ticker.deltaTime;
              var w = app.screen.width;
              var h = app.screen.height;
              for (var j = owls.length - 1; j >= 0; j--) {
                var p = owls[j];
                p.driftPhase += p.driftSpeed * dt;
                p.bobPhase   += p.bobSpeed * dt;
                p.x += Math.sin(p.driftPhase) * p.driftAmp * dt;
                p.y += (p.vy + Math.sin(p.bobPhase) * p.bobAmp) * dt;
                p.rotation += p.spin * dt;
                if (p.x < -60) p.x = w + 60;
                else if (p.x > w + 60) p.x = -60;
                if (p.y < -80) {
                  stage.removeChild(p);
                  p.destroy();
                  owls.splice(j, 1);
                }
              }
              var want = targetCount();
              while (owls.length < want) spawn(true);
            });
          });
        }).catch(function () { /* swallow init errors — page still readable */ });
      })();
